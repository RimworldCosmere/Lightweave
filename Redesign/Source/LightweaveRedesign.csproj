<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Authors>CryptikLemur</Authors>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <OutDir>..\Assemblies\</OutDir>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <WarningLevel>4</WarningLevel>
        <ErrorReport>prompt</ErrorReport>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <PlatformTarget Condition=" '$(Platform)' == '' ">AnyCPU</PlatformTarget>

        <FileAlignment>512</FileAlignment>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>embedded</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>

        <PackageId>Cosmere.Lightweave.Redesign</PackageId>
        <RootNamespace>Cosmere.Lightweave.Redesign</RootNamespace>
        <AssemblyName>LightweaveRedesign</AssemblyName>

        <Title>Cosmere.Lightweave.Redesign</Title>
        <Description>Reimagined main menu, mod manager, load colony, and options screens, built on the Lightweave framework.</Description>
        <Authors>CryptikLemur</Authors>
        <Company>RimworldCosmere</Company>
        <Copyright>Copyright (c) RimworldCosmere contributors</Copyright>
        <PackageProjectUrl>https://github.com/RimworldCosmere/Lightweave</PackageProjectUrl>
        <RepositoryUrl>https://github.com/RimworldCosmere/Lightweave</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>rimworld;modding;imgui;ui;lightweave;cosmere</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
        <PackageReference>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <Using Include="System.Linq"/>
        <Using Include="System.Collections.Generic"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CryptikLemur.RimLogging" Version="[1.0.2,2.0.0)"/>
        <PackageReference Include="Concord.Ref" Version="0.4.1" PrivateAssets="all"/>
        <PackageReference Include="Concord.Analyzers" Version="0.4.1" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <ProjectReference Include="..\..\Framework\Source\Lightweave.csproj">
            <Private>False</Private>
        </ProjectReference>

    </ItemGroup>

    <PropertyGroup>
        <RealRimWorldManaged Condition="'$(RealRimWorldManaged)' == '' And Exists('..\..\RimWorldWin64_Data\Managed')">..\..\RimWorldWin64_Data\Managed</RealRimWorldManaged>
        <RealRimWorldManaged Condition="'$(RealRimWorldManaged)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RealRimWorldManaged>
        <RealRimWorldManaged Condition="'$(RealRimWorldManaged)' == '' And Exists('/mnt/games/RimWorld/RimWorldLinux_Data/Managed')">/mnt/games/RimWorld/RimWorldLinux_Data/Managed</RealRimWorldManaged>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*"/>
    </ItemGroup>

    <Target Name="UseRealAssemblyCSharp" AfterTargets="ResolveAssemblyReferences" Condition="'$(RealRimWorldManaged)' != ''">
        <ItemGroup>
            <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'Assembly-CSharp' Or '%(FileName)' == 'Assembly-CSharp_publicised'"/>
            <ReferencePath Include="$(RealRimWorldManaged)\Assembly-CSharp.dll"/>
        </ItemGroup>
    </Target>
</Project>
