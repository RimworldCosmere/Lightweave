<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
    <name>Lightweave Redesign</name>
    <description>Reimagined main menu, mod manager, load colony, and options screens, built on the Lightweave framework.</description>
    <authors>
        <li>CryptikLemur</li>
        <li>Luucid</li>
    </authors>
    <supportedVersions>
        <li>1.6</li>
    </supportedVersions>
    <packageId>Cosmere.Lightweave.Redesign</packageId>
    <modDependencies>
        <li>
            <packageId>Cosmere.Lightweave</packageId>
            <displayName>Lightweave</displayName>
            <downloadUrl>https://github.com/RimworldCosmere/Lightweave/releases/latest</downloadUrl>
        </li>
        <li>
            <packageId>cryptiklemur.rimlogging</packageId>
            <displayName>RimLogging</displayName>
            <downloadUrl>https://github.com/cryptiklemur/rimworld-logging-framework</downloadUrl>
        </li>
    </modDependencies>
    <forceLoadAfter>
        <li>Cosmere.Lightweave</li>
    </forceLoadAfter>
    <loadAfter>
        <li>cryptiklemur.rimlogging</li>
    </loadAfter>
</ModMetaData>
